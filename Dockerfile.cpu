FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt

# Install CPU PyTorch - adjust torchvision if needed
RUN pip install --no-cache-dir "torch==2.2.0+cpu" "torchvision==0.15.2+cpu" -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

EXPOSE 7860

CMD ["python", "app_gradio.py", "--port", "7860"]
